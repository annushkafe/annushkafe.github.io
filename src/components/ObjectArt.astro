        <rect class="solid" x="98" y="50" width="22" height="92" />
        {range(60, 132, 7).map((y) => <path class="pp-ln" d={`M100 ${y} l9 -5`} />)}
        <rect class="st" x="40" y="116" width="62" height="26" />
        {range(50, 58, 3).map((x) => <path class="ln-t" d={`M${x} 66 v42`} />)}
      </g>
      <path class="ln" d={jarBody} />
      <rect class="x ln" x="58" y="44" width="44" height="9" />
