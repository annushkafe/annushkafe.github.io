---
// Woodcut / engraving tattoo-flash illustrations.
// Language: solid ink masses with "carved" paper highlights, crosshatch and
// stipple for mid-tones, high-contrast negative space, red only as an accent.
// Gothic-romantic motifs (roses, daggers, flames, swallows) come from Motif.astro.
// Textures come from FlashDefs.astro (rendered once per page).
import type { ObjectName } from '../data/projects';
import Motif from './Motif.astro';

interface Props { name: ObjectName; class?: string; sparkles?: boolean }
const { name, class: className, sparkles = true } = Astro.props;
const uid = `o${Math.random().toString(36).slice(2, 8)}`;

const sparkle = (x: number, y: number, s: number) =>
  `M${x} ${y - s} Q${x + s * 0.12} ${y - s * 0.12} ${x + s} ${y} Q${x + s * 0.12} ${y + s * 0.12} ${x} ${y + s} Q${x - s * 0.12} ${y + s * 0.12} ${x - s} ${y} Q${x - s * 0.12} ${y - s * 0.12} ${x} ${y - s}Z`;

const star = (x: number, y: number, r: number) => {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const a = (Math.PI / 5) * i - Math.PI / 2;
    const rr = i % 2 === 0 ? r : r * 0.42;
    pts.push(`${(x + Math.cos(a) * rr).toFixed(2)},${(y + Math.sin(a) * rr).toFixed(2)}`);
  }
  return `M${pts.join('L')}Z`;
};

const beads = (cx: number, cy: number, rx: number, ry: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2;
    return { x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry };
  });

const range = (from: number, to: number, step: number) => {
  const out: number[] = [];
  for (let v = from; v <= to; v += step) out.push(v);
  return out;
};

const heart = (x: number, y: number, s: number) =>
  `M${x} ${y + s} C${x - s * 1.5} ${y + s * 0.1} ${x - s * 1.3} ${y - s * 1.1} ${x - s * 0.45} ${y - s * 0.95} C${x - s * 0.15} ${y - s * 0.9} ${x} ${y - s * 0.6} ${x} ${y - s * 0.4} C${x} ${y - s * 0.6} ${x + s * 0.15} ${y - s * 0.9} ${x + s * 0.45} ${y - s * 0.95} C${x + s * 1.3} ${y - s * 1.1} ${x + s * 1.5} ${y + s * 0.1} ${x} ${y + s}Z`;

const thorn = (x: number, y: number) => `M${x} ${y} l2.2 -5.5 l2.2 5.5z`;

// One petal of the block-print ornament, pointing up from the centre (80, 80).
const petal = 'M80 54 C71 52 64 46 62 39 C55 41 49 35 50 28 C52 20 60 19 64 24 C64 14 71 8 80 8 C89 8 96 14 96 24 C100 19 108 20 110 28 C111 35 105 41 98 39 C96 46 89 52 80 54Z';

const jarBody ='M46 60 q0 -8 8 -8 h52 q8 0 8 8 v62 q0 16 -16 16 h-36 q-16 0 -16 -16z';
---
<svg class:list={['obj', className]} viewBox="0 0 160 160" aria-hidden="true" focusable="false">
  <g filter="url(#fx-ink)">

  {name === 'jar' && (
    <g>
      <defs><clipPath id={`${uid}-b`}><path d={jarBody} /></clipPath></defs>
      <path class="pp" d={jarBody} />
