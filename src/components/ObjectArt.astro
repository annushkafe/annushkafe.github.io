  @keyframes obj-wink { 0%, 30% { opacity: 0; } 32%, 62% { opacity: 1; } 64%, 100% { opacity: 0; } }

  /* Envelope: flap opens, letter slides out, swallow takes off */
  .a-flap { transform-origin: 80px 62px; transition: transform 420ms var(--ease-out); }
  :global(a:is(:hover, :focus-visible)) .a-flap { transform: scaleY(-1); }
  .a-letter { opacity: 0; transition: transform 500ms var(--ease-out), opacity 200ms; }
  :global(a:is(:hover, :focus-visible)) .a-letter { opacity: 1; transform: translateY(-30px); transition-delay: 180ms; }
  .a-fly { transition: transform 650ms var(--ease-out); }
