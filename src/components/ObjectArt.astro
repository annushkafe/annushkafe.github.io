  @keyframes obj-bob { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-5px) rotate(-3deg); } }

  /* Whiskey glass: a little swirl */
  .a-tilt { transform-origin: 80px 140px; }
