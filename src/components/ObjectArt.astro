<style>
  .obj { width: 100%; height: auto; overflow: visible; }
  .obj :global(.ln) { fill: none; stroke: var(--flash-ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .obj :global(.ln-t) { fill: none; stroke: var(--flash-ink); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .obj :global(.pp-ln) { fill: none; stroke: var(--paper); stroke-width: 1.5; stroke-linecap: round; }
  .obj :global(.pp) { fill: var(--paper); }
  .obj :global(.h) { fill: url(#fx-hatch); }
  .obj :global(.hd) { fill: url(#fx-hatch-d); }
  .obj :global(.x) { fill: url(#fx-cross); }
  .obj :global(.st) { fill: url(#fx-stipple); }
  .obj :global(.solid) { fill: var(--flash-ink); }
  .obj :global(.red) { fill: var(--flash-red); }
  /* Fill + outline combinations */
  .obj :global(.pp.ln), .obj :global(.pp.ln-t) { fill: var(--paper); }
  .obj :global(.red.ln), .obj :global(.red.ln-t) { fill: var(--flash-red); }
  .obj :global(.solid.ln) { fill: var(--flash-ink); }
  .obj :global(.hd.ln) { fill: url(#fx-hatch-d); }
  .obj :global(.h.ln) { fill: url(#fx-hatch); }
  .obj :global(.x.ln) { fill: url(#fx-cross); }
  .obj :global(.st.ln) { fill: url(#fx-stipple); }

  /* ---------- Hover animations ----------
     Triggered when the surrounding link is hovered or keyboard-focused.
     Pivots are in the 160×160 artboard's own units (transform-box: view-box). */
  .obj g, .obj path { transform-box: view-box; }

  .tw { transform-box: fill-box; transform-origin: center; }
  :global(a:is(:hover, :focus-visible)) .tw { animation: obj-twinkle 700ms ease-in-out infinite alternate; }
  @keyframes obj-twinkle { to { transform: scale(1.4) rotate(30deg); } }

  /* Jar: lid twists open */
  .a-lid { transform-origin: 80px 36px; transition: transform 420ms var(--ease-out); }
  :global(a:is(:hover, :focus-visible)) .a-lid { transform: translate(4px, -11px) rotate(-14deg); }

  /* Hanger: swings from the hook */
  .a-swing { transform-origin: 80px 18px; }
  :global(a:is(:hover, :focus-visible)) .a-swing { animation: obj-swing 1.4s ease-in-out infinite; }
  @keyframes obj-swing { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(7deg); } 75% { transform: rotate(-7deg); } }

  /* Pattern: slow turn on hover */
  .a-spin { transform-origin: 80px 80px; transition: transform 900ms var(--ease-out); }
  :global(:is(a, button):is(:hover, :focus-visible)) .a-spin { transform: rotate(72deg); }

