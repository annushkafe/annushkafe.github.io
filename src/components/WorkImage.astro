---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { src, alt, sizes = '(max-width: 760px) 100vw, 900px', eager = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/**/*.{jpg,jpeg,png,gif,webp}', { eager: true });
const mod = files[`/src/assets/work/${src}`];
if (!mod) throw new Error(`WorkImage: missing src/assets/work/${src}`);
const img = mod.default;
const isGif = src.toLowerCase().endsWith('.gif');
---
{isGif
  ? <img class={className} src={img.src} width={img.width} height={img.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  : <Image class={className} src={img} alt={alt} widths={[480, 900, 1400].filter((w) => w <= img.width).concat(img.width < 480 ? [img.width] : [])} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />}
