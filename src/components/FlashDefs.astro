---
// Shared engraving textures for every flash-style illustration on the page.
// Rendered once in the layout; illustrations reference these ids.
---
<svg class="flash-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="fx-hatch" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <line x1="0" y1="0" x2="0" y2="3.2" class="fx-p" stroke-width="0.85" />
    </pattern>
    <pattern id="fx-hatch-d" width="2.1" height="2.1" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <line x1="0" y1="0" x2="0" y2="2.1" class="fx-p" stroke-width="0.9" />
    </pattern>
    <pattern id="fx-cross" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <line x1="0" y1="0" x2="0" y2="3" class="fx-p" stroke-width="0.7" />
      <line x1="0" y1="0" x2="3" y2="0" class="fx-p" stroke-width="0.7" />
    </pattern>
    <pattern id="fx-stipple" width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="0.55" class="fx-d" />
      <circle cx="3" cy="3" r="0.45" class="fx-d" />
      <circle cx="3.2" cy="0.6" r="0.3" class="fx-d" />
    </pattern>
    <pattern id="fx-lines" width="4" height="2.4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0.5" x2="4" y2="0.5" class="fx-p" stroke-width="0.7" />
    </pattern>
    <!-- Slightly wobbly, printed-ink line quality -->
    <filter id="fx-ink" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<style>
  .flash-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .flash-defs :global(.fx-p) { stroke: var(--flash-ink); }
  .flash-defs :global(.fx-d) { fill: var(--flash-ink); }
</style>
